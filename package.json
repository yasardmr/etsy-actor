{
  "name": "etsy-scraper-pro",
  "version": "1.0.0",
  "description": "Professional Etsy scraper with sales estimator, trend analysis, and competitive intelligence",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc",
    "dev": "npm run build && apify run -p",
    "test": "jest",
    "test-datadome": "npm run build && node dist/test-datadome-bypass.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "push": "apify push"
  },
  "keywords": [
    "etsy",
    "scraper",
    "ecommerce",
    "dropshipping",
    "product-research",
    "sales-estimator",
    "trend-analysis",
    "competitive-intelligence",
    "apify",
    "actor"
  ],
  "author": "WebDataLabs",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^24.5.2",
    "apify": "^3.4.5",
    "axios": "^1.12.2",
    "crawlee": "^3.15.0",
    "ghost-cursor-playwright": "^2.1.0",
    "rebrowser-playwright": "^1.52.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "ts-node": "^10.9.2"
  }
}
